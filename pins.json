{
  "pins": [
    { "kind": "conventions", "file": "conventions.json", "repo": "robertblust/conventions" },
    { "kind": "npm-tag", "file": "package.json", "repo": "robertblust/design", "after": ["npm run design", "npm run pages", "npm run pictures", "npm run pages", "npm run og", "npm run sitemap"] },
    { "kind": "npm-tag", "file": "package.json", "repo": "companygraph/meta-model", "after": ["npm run model", "npm run pages", "npm run pictures", "npm run pages", "npm run og", "npm run sitemap"] },
    { "kind": "npm-tag", "file": "package.json", "repo": "companygraph/mcp-server", "after": ["npm run pages", "npm run pictures", "npm run pages", "npm run og", "npm run sitemap"] },
    { "kind": "source-commit", "file": "source.json", "repo": "guestgraph/mental-model", "after": ["npm run model", "npm run pages", "npm run pictures", "npm run pages", "npm run og", "npm run sitemap"] },
    { "kind": "source-commit", "file": "api-sources.json", "repo": "guestgraph/engine", "watch": ["src/main/resources/api/openapi.yaml"], "after": ["npm run api", "npm run og", "npm run sitemap"] },
    { "kind": "source-commit", "file": "api-sources.json", "repo": "guestgraph/connector-apaleo", "watch": ["src/main/resources/api/openapi.yaml"], "after": ["npm run api", "npm run og", "npm run sitemap"] }
  ],
  "verify": [
    "npm ci",
    "cd talks/intro/tts && ./generate.py --dry-run",
    "npm run test:og",
    "npm run og:check",
    "npm run design:check",
    "npm run sitemap:check",
    "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} npm run model:check",
    "npm run pages:check",
    "npm run api:check",
    "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} npm run pin:check",
    "npx playwright install --with-deps chromium",
    "PORT=$(python3 -c 'import socket; s = socket.socket(); s.bind((\"\", 0)); print(s.getsockname()[1])'); ./node_modules/.bin/design serve --port $PORT & SERVER_PID=$!; sleep 1; BASE=http://localhost:$PORT npm run verify && npx design links --base http://127.0.0.1:$PORT; STATUS=$?; kill $SERVER_PID; exit $STATUS"
  ]
}

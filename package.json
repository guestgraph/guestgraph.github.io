{
  "name": "guestgraph-io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "design": "design sync",
    "design:check": "design sync --check",
    "sitemap": "design sitemap",
    "sitemap:check": "design sitemap --check",
    "model": "node build/model.mjs",
    "model:check": "node build/model.mjs --check",
    "pages": "node build/pages.mjs",
    "pages:check": "node build/pages.mjs --check",
    "verify": "node verify/check.mjs",
    "pdf": "node export-pdf.mjs",
    "og": "node export-og.mjs",
    "og:check": "node og-check.mjs",
    "test:og": "node --test verify/og-recipe.test.mjs",
    "api": "node build-api.mjs",
    "api:check": "node build-api.mjs --check",
    "pin:check": "node pin-check.mjs"
  },
  "devDependencies": {
    "@robertblust/design": "github:robertblust/design#v0.90.0",
    "companygraph-meta-model": "github:companygraph/meta-model#v0.46.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "yaml": "^2.8.1"
  }
}
